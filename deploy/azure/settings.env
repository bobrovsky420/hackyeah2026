# The Azure deployment's settings (docs/azure-deploy.md), read by
# .github/workflows/deploy-azure.yml. Nothing secret: the secrets live in
# the Key Vault named below. deploy/azure/bootstrap.sh prints the AZURE_
# lines; anyone with write access commits them. Plain KEY=VALUE lines.

AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=hackyeah2026-rg
AZURE_VM_NAME=router
AZURE_DNS_LABEL=
AZURE_KEY_VAULT=

# The data release deployed (the GitHub release data-X.Y.Z with its zip);
# the workflow's input overrides it for one run.
DATA_RELEASE=0.0.6

# Optional: 4 GB (Standard_B2s) is the minimum (docs/server-deploy.md).
AZURE_VM_SIZE=Standard_B2ms
# Optional: the repository with the data releases, default this one.
DATA_REPO=
