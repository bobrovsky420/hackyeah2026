# The server's settings (docs/server-deploy.md). Copy to .env.server at the
# repository root (git-ignored), fill in, and keep it readable by the owner
# only (chmod 600). Both systemd units and deploy/update.sh read it.
# Plain KEY=VALUE lines: systemd reads this file too.

# The data release built into the app (.local/bundles/data-X.Y.Z.zip, or
# the GitHub release data-X.Y.Z with GITHUB_TOKEN below).
DATA_RELEASE=0.0.2

# Bielik on the Hugging Face router at run time; the first download of the
# gated PolDense model by deploy/setup.sh needs it too.
HF_TOKEN=

# The fallback provider.
ANTHROPIC_API_KEY=

# The shared code of the ROPS panel at /rops; without it the panel stays locked.
ROPS_TOKEN=

# Optional:
# GITHUB_TOKEN=          only to download the data release from GitHub while the repository is private
# DATA_SHA256=           pins the zip
# REPLAY_ONLY=true       no model calls: only the cached routes answer
# RATE_LIMIT_ROUTES_PER_MINUTE=10
# EMBEDDING_MODEL=OPI-PIB/PolDense-400M
